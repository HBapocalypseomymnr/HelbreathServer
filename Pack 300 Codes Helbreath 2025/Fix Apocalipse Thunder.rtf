// Local execution off a global GM command to force open the gate  \par
// Beware this will affect only current server  \par
//**************************************************************************************  \par
void CGame::ForceOpen_ApocalypseGate()  \par
\{ if (m_bIsApocalypseMode == FALSE) return;  \par
DWORD dwTime = timeGetTime();  \par
m_dwApocalypseGateOpenTime = dwTime;  \par
m_dwApocalypseGateCloseTime = dwTime +15*60*1000; // will close in 15 minutes  \par
OpenCloseApocalypseGate();  \par
\}  \par
