// SNOOPY: Revamped Apocalypse functions:  \par
// ForceClose_ApocalypseGate  \par
// GM command to force open the gate  \par
// Beware this will affect only current server  \par
//**************************************************************************************  \par
void CGame::ForceClose_ApocalypseGate()  \par
\{ if (m_bIsApocalypseMode == FALSE) return;  \par
DWORD dwTime = timeGetTime();  \par
m_dwApocalypseGateCloseTime = dwTime -1;  \par
m_dwApocalypseGateOpenTime = dwTime -100; // alreaddy closed  \par
OpenCloseApocalypseGate();  \par
\}  \par
