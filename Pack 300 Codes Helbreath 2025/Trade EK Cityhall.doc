C\'f3digo:\par
void CGame::GetTradeEKMantleHandler(int iClientH,int iItemID,char * pString) // TRADE EK - Luqah\par
\{\par
int   i, iNum, iRet, iEraseReq; \par
char  * cp, cData[256], cItemName[21]; \par
class CItem * pItem; \par
DWORD * dwp; \par
short * sp; \par
WORD  * wp; \par
\par
    if (m_pClientList[iClientH] == NULL) return; \par
    if (_iGetItemSpaceLeft(iClientH) == 0) \{\par
        SendItemNotifyMsg(iClientH,    DEF_NOTIFY_CANNOTCARRYMOREITEM, NULL, NULL);\par
        return;\par
    \}\par
    if (m_pItemConfigList[iItemID] == NULL)  return;\par
\par
    switch(iItemID)\par
    \{\par
        case 616:// Demon\par
            if(m_pClientList[iClientH]->m_iEnemyKillCount <= 899) return; \par
            m_pClientList[iClientH]->m_iEnemyKillCount -= 900;\par
            break; \par
        case 849://KB\par
            if(m_pClientList[iClientH]->m_iEnemyKillCount <= 799) return; \par
            m_pClientList[iClientH]->m_iEnemyKillCount -= 800;\par
            break; \par
        case 848://LB\par
            if(m_pClientList[iClientH]->m_iEnemyKillCount <= 2099) return; \par
            m_pClientList[iClientH]->m_iEnemyKillCount -= 2100;\par
            break; \par
        case 847://DarkExecutor \par
            if(m_pClientList[iClientH]->m_iEnemyKillCount <= 1649) return; \par
            m_pClientList[iClientH]->m_iEnemyKillCount -= 1650;\par
            break; \par
        case 845://SB\par
            if(m_pClientList[iClientH]->m_iEnemyKillCount <= 2999) return; \par
            m_pClientList[iClientH]->m_iEnemyKillCount -= 3000;\par
            break; \par
        case 846://devas\par
            if(m_pClientList[iClientH]->m_iEnemyKillCount <= 3599) return; \par
            m_pClientList[iClientH]->m_iEnemyKillCount -= 3600;\par
            break; \par
            \}\par
    ZeroMemory(cItemName, sizeof(cItemName)); \par
    memcpy(cItemName,m_pItemConfigList[iItemID]->m_cName,20); \par
    iNum = 1;\par
    for (i = 1; i <= iNum; i++)\par
    \{\par
        pItem = new class CItem; \par
        if (_bInitItemAttr(pItem, cItemName) == FALSE) \par
        \{\par
            delete pItem; \par
        \}\par
        else\par
        \{ \par
            if (_bAddClientItemList(iClientH, pItem, &iEraseReq) == TRUE)\par
            \{ \par
                if (m_pClientList[iClientH]->m_iCurWeightLoad < 0) m_pClientList[iClientH]->m_iCurWeightLoad = 0; \par
                wsprintf(G_cTxt, "(*) Get Trade EK Item : Char(%s) Player-EK(%d) Item Obtained(%s)", m_pClientList[iClientH]->m_cCharName, m_pClientList[iClientH]->m_iEnemyKillCount,cItemName); \par
                PutItemLogFileList(G_cTxt);\tab\par
                \par
                dwp  = (DWORD *)(cData + DEF_INDEX4_MSGID); \par
                *dwp = MSGID_NOTIFY; \par
                wp   = (WORD *)(cData + DEF_INDEX2_MSGTYPE); \par
                *wp  = DEF_NOTIFY_ITEMOBTAINED; \par
                cp = (char *)(cData + DEF_INDEX2_MSGTYPE + 2);\par
                \par
                *cp = 1;\par
                cp++; \par
\par
                memcpy(cp, pItem->m_cName, 20); \par
                cp += 20; \par
                \par
                dwp  = (DWORD *)cp;\par
                *dwp = pItem->m_dwCount; \par
                cp += 4;\par
                \par
                *cp = pItem->m_cItemType; \par
                cp++; \par
                \par
                *cp = pItem->m_cEquipPos; \par
                cp++; \par
\par
                *cp = (char)0;\par
                cp++; \par
\par
                sp  = (short *)cp;\par
                *sp = pItem->m_sLevelLimit; \par
                cp += 2; \par
\par
                *cp = pItem->m_cGenderLimit; \par
                cp++; \par
\par
                wp = (WORD *)cp;\par
                *wp = pItem->m_wCurLifeSpan; \par
                cp += 2; \par
\par
                wp = (WORD *)cp; \par
                *wp = pItem->m_wWeight;\par
                cp += 2; \par
\par
                sp  = (short *)cp; \par
                *sp = pItem->m_sSprite; \par
                cp += 2; \par
\par
                sp  = (short *)cp; \par
                *sp = pItem->m_sSpriteFrame; \par
                cp += 2; \par
\par
                *cp = pItem->m_cItemColor; \par
                cp++; \par
\par
                *cp = (char)pItem->m_sItemSpecEffectValue2; \par
                cp++; \par
\par
                dwp = (DWORD *)cp; \par
                *dwp = pItem->m_dwAttribute; \par
                cp += 4; \par
\par
                if (iEraseReq == 1) delete pItem; \par
                iRet = m_pClientList[iClientH]->m_pXSock->iSendMsg(cData, 53);\par
                iCalcTotalWeight(iClientH); \par
\par
                switch (iRet)\par
                \{ \par
                    case DEF_XSOCKEVENT_QUENEFULL: \par
                    case DEF_XSOCKEVENT_SOCKETERROR: \par
                    case DEF_XSOCKEVENT_CRITICALERROR:\par
                    case DEF_XSOCKEVENT_SOCKETCLOSED: \par
                    DeleteClient(iClientH, TRUE, TRUE);\par
                    return; \par
                \} \par
                SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_ENEMYKILLS, m_pClientList[iClientH]->m_iEnemyKillCount, NULL, NULL, NULL);\par
            \} \par
            else \par
            \{ \par
                delete pItem; \par
\par
                iCalcTotalWeight(iClientH);\par
                \par
                dwp  = (DWORD *)(cData + DEF_INDEX4_MSGID);\par
                *dwp = MSGID_NOTIFY; \par
                wp   = (WORD *)(cData + DEF_INDEX2_MSGTYPE);\par
                *wp  = DEF_NOTIFY_CANNOTCARRYMOREITEM;\par
                \par
                iRet = m_pClientList[iClientH]->m_pXSock->iSendMsg(cData, 6);\par
                switch (iRet)\par
                \{ \par
                    case DEF_XSOCKEVENT_QUENEFULL: \par
                    case DEF_XSOCKEVENT_SOCKETERROR:\par
                    case DEF_XSOCKEVENT_CRITICALERROR: \par
                    case DEF_XSOCKEVENT_SOCKETCLOSED:\par
                        DeleteClient(iClientH, TRUE, TRUE);\par
                        return; \par
                \}    \par
            \} \par
        \} \par
    \}    \par
\}\par
