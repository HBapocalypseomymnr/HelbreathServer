         if (m_pBuildItemList[i]->m_iMaterialItemCount[x] == 0) iMatch++; // \'b0\'b9\'bc\'f6\'b0\'a1 0\'c0\'b8\'b7\'ce \'bc\'b3\'c1\'a4\'b5\'c7\'be\'ee \'c0\'d6\'b4\'c2 \'b0\'cd\'c0\'ba \'b9\'ab\'bd\'c3\'c7\'cf\'b4\'c2 \'c7\'c3\'b7\'a1\'b1\'d7\'c0\'cc\'b4\'d9.\par
         else \{\par
            bFlag = FALSE;\par
            for (z = 0; z < DEF_MAXITEMS; z++)\par
            if ((m_pClientList[iClientH]->m_pItemList[z] != NULL)) \{\par
               if ((m_pClientList[iClientH]->m_pItemList[z]->m_sIDnum  == m_pBuildItemList[i]->m_iMaterialItemID[x]) &&\par
                  (m_pClientList[iClientH]->m_pItemList[z]->m_dwCount >= m_pBuildItemList[i]->m_iMaterialItemCount[x]) &&\par
                  (bItemFlag[z] == FALSE)) \{\par
                  \par
                  m_pBuildItemList[i]->m_iIndex[x] = z;\par
                  bItemFlag[z] = TRUE;\par
                  iTotalValue += (m_pClientList[iClientH]->m_pItemList[z]->m_sItemSpecEffectValue1 * m_pBuildItemList[i]->m_iMaterialItemValue[x]);\par
                  \par
                  bFlag = TRUE;\par
                  goto BIH_LOOPBREAK;\par
               \}\par
            \}\par
            \par
BIH_LOOPBREAK:;\par
            // \'be\'c6\'c0\'cc\'c5\'db\'c0\'cc \'c3\'e6\'ba\'d0\'c7\'cf\'b4\'d9\'b8\'e9\par
            if (bFlag == TRUE) iMatch++;\par
         \}\par
         \par
         if (iMatch != 6) \{\par
            // \'c0\'e7\'b7\'e1 \'ba\'ce\'c1\'b7. \'be\'c6\'c0\'cc\'c5\'db \'c1\'a6\'c0\'db \'ba\'d2\'b0\'a1\par
            SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_BUILDITEMFAIL, NULL, NULL, NULL, NULL);\par
            return;\par
         \}\par
\par
         //testcode\par
         wsprintf(G_cTxt, "iTotalValue(%d) MaxValue(%d)", iTotalValue, m_pBuildItemList[i]->m_iMaxValue);\par
         PutLogList(G_cTxt);\par
\par
         // \'bc\'f8\'b5\'b5 \'b0\'e8\'bb\'ea\par
         dV2 = (double)m_pBuildItemList[i]->m_iMaxValue;\par
         if (iTotalValue <= 0)\par
             dV3 = 1.0f;\par
         else dV3 = (double)iTotalValue;\par
         dV1 = (double)(dV3/dV2)*100.0f;\par
\par
         // \'b9\'e9\'ba\'d0\'b7\'fc\'b7\'ce \'b9\'d9\'b2\'ef \'b0\'aa.\par
         iTotalValue = (int)dV1;\par
\par
         //testcode\par
         wsprintf(G_cTxt, "iTotalValue(%d)", iTotalValue);\par
         PutLogList(G_cTxt);\par
      \par
         \par
         // \'be\'c6\'c0\'cc\'c5\'db \'c1\'a6\'c0\'db \'c1\'b6\'b0\'c7\'c0\'cc \'b8\'b8\'c1\'b7\'b5\'c7\'be\'fa\'b4\'d9. \'be\'c6\'c0\'cc\'c5\'db\'c0\'bb \'b8\'b8\'b5\'e9\'b0\'ed \'c0\'e7\'b7\'e1\'b8\'a6 \'c1\'d9\'c0\'ce\'b4\'d9.\par
            \par
         // \'c0\'e7\'b7\'e1\'b0\'a1 \'b5\'c7\'b4\'c2 \'be\'c6\'c0\'cc\'c5\'db\'c0\'bb \'be\'f8\'be\'d8\'b4\'d9.\par
         for (x = 0; x < 6; x++)\par
         if (m_pBuildItemList[i]->m_iIndex[x] != -1) \{\par
            iIndex = m_pBuildItemList[i]->m_iIndex[x];\par
            iCount = m_pClientList[iClientH]->m_pItemList[iIndex]->m_dwCount - m_pBuildItemList[i]->m_iMaterialItemCount[x];\par
            if (iCount < 0) iCount = 0;\par
            SetItemCount(iClientH, iIndex, iCount);\par
         \}\par
\par
         // \'be\'c6\'c0\'cc\'c5\'db \'bb\'fd\'bc\'ba\par
         pItem = new class CItem;\par
         if (_bInitItemAttr(pItem, m_pBuildItemList[i]->m_cName) == FALSE) \{\par
            delete pItem;\par
            return;\par
         \}\par
\par
         if (pItem->m_cItemType == DEF_ITEMTYPE_MATERIAL) \{\par
            // \'b8\'b8\'b5\'e9\'be\'ee\'c1\'f8 \'be\'c6\'c0\'cc\'c5\'db\'c0\'cc \'b9\'ab\'b1\'e2 \'c1\'a6\'c0\'db \'c0\'e7\'b7\'e1(\'c0\'d7\'b0\'f7)\'c0\'cc\'b6\'f3\'b8\'e9 \'b1\'e2\'bc\'fa \'bc\'f6\'c1\'d8\'bf\'a1 \'b5\'fb\'b8\'a5 \'bc\'f8\'b5\'b5\'b8\'a6 \'c0\'d4\'b7\'c2\'c7\'d1\'b4\'d9.\par
            pItem->m_sItemSpecEffectValue1 = iDice(1, iPlayerSkillLevel);\par
            // \'c3\'d6\'c0\'fa \'bc\'f8\'b5\'b5\par
            if (pItem->m_sItemSpecEffectValue1 < (iPlayerSkillLevel/2))\par
               pItem->m_sItemSpecEffectValue1 = (iPlayerSkillLevel/2);\par
         \}\par
         else \{\par
            // \'b9\'ab\'b1\'e2 \'c1\'a6\'c0\'db \'c0\'e7\'b7\'e1\'b0\'a1 \'be\'c6\'b4\'cf\'b0\'ed \'b9\'ab\'b1\'e2\'b3\'aa \'b9\'e6\'be\'ee\'b1\'b8\'b7\'f9\'b6\'f3\'b8\'e9\par
\par
            // \'be\'c6\'c0\'cc\'c5\'db\'c0\'cc Custom-Made\'c0\'d3\'c0\'bb \'b3\'aa\'c5\'b8\'b3\'bb\'b4\'c2 \'c7\'c3\'b7\'a1\'b1\'d7\'b8\'a6 \'c0\'d4\'b7\'c2\par
            dwTemp = pItem->m_dwAttribute;\par
            dwTemp = dwTemp | 0x00000001;\par
            pItem->m_dwAttribute = dwTemp;\par
\par
            iResultValue = (iTotalValue - m_pBuildItemList[i]->m_iAverageValue);\par
            //\'c0\'e7\'b7\'e1 \'bc\'f8\'b5\'b5\'bf\'a1 \'b5\'fb\'b8\'a5 \'bc\'ba\'b4\'c9 \'c0\'d4\'b7\'c2: SpecEffectValue1\'c0\'ba \'bc\'f6\'b8\'ed, SpecEffectValue2\'b4\'c2 \'bc\'ba\'b4\'c9 \'b0\'a1\'c1\'df\'c4\'a1\par
            \par
            //testcode\par
            wsprintf(G_cTxt, "iResultValue(%d) %d %d", iResultValue, iTotalValue, m_pBuildItemList[i]->m_iAverageValue);\par
            PutLogList(G_cTxt);\par
      \par
            // 1. \'bb\'f5\'b7\'ce\'bf\'ee \'c3\'d6\'b4\'eb \'bc\'f6\'b8\'ed \'b0\'e8\'bb\'ea\par
            if (iResultValue == 0)\par
                dV2 = 1.0f;\par
            else dV2 = (double)iResultValue;\par
            dV3 = (double)pItem->m_wMaxLifeSpan;\par
            dV1 = (dV2/100.0f)*dV3;\par
\par
            iTemp  = (int)pItem->m_wMaxLifeSpan;\par
            iTemp += (int)dV1;\par
\par
            if (iTemp <= 0)\par
                wTemp = 1;\par
            else wTemp = (WORD)iTemp;\par
\par
            if (wTemp <= pItem->m_wMaxLifeSpan*2) \{\par
               // \'bf\'a1\'b7\'af\'b7\'ce \'c0\'ce\'c7\'d8 \'b3\'ca\'b9\'ab \'b8\'b9\'c0\'ba \'bc\'f6\'b8\'ed\'b0\'aa\'c0\'cc \'b3\'aa\'bf\'c8\'c0\'bb \'b8\'b7\'b1\'e2\'c0\'a7\'c7\'d4\par
               pItem->m_wMaxLifeSpan = wTemp;\par
               pItem->m_wCurLifeSpan = wTemp;\par
               pItem->m_sItemSpecEffectValue1 = (short)wTemp;\par
            \}\par
            else pItem->m_sItemSpecEffectValue1 = (short)pItem->m_wMaxLifeSpan;\par
            \par
            // 2. \'bc\'ba\'b4\'c9 \'b0\'a1\'c1\'df\'c4\'a1 \'b0\'e8\'bb\'ea(\'b9\'e9\'ba\'d0\'c0\'b2)\par
            if (iResultValue > 0) \{\par
               dV2 = (double)iResultValue;\par
               dV3 = (double)(100 - m_pBuildItemList[i]->m_iAverageValue);\par
               dV1 = (dV2/dV3)*100.0f;\par
               pItem->m_sItemSpecEffectValue2 = (int)dV1;\par
            \}\par
            else if (iResultValue < 0) \{\par
               dV2 = (double)abs(iResultValue);\par
               dV3 = (double)(m_pBuildItemList[i]->m_iAverageValue);\par
               dV1 = (dV2/dV3)*100.0f;\par
               pItem->m_sItemSpecEffectValue2 = -1*abs(100 - (int)dV1);\par
            \}\par
            else pItem->m_sItemSpecEffectValue2 = 0;\par
         \}\par
\par
         //testcode\par
         wsprintf(G_cTxt, "Custom-Item(%s) Value(%d)", pItem->m_cName, pItem->m_sItemSpecEffectValue2);\par
         PutLogList(G_cTxt);\par
      \par
         // \'be\'c6\'c0\'cc\'c5\'db \'c0\'fc\'b4\'de\par
         bAddItem(iClientH, pItem, NULL);\par
         SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_BUILD\par
}
