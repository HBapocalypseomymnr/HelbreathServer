//50Cent - Capture The Flag\par
void CGame::StartCaptureTheFlag()\par
\{\par
    if(m_bIsCTFMode) return;\par
    \par
    m_sFlagCountWin = 5;\par
    \par
    wsprintf(G_cTxt,"Capture The Flag: Win Flag Count(%d)", m_sFlagCountWin);\par
    PutLogList(G_cTxt);\par
\par
    m_bIsCTFMode = true;\par
\par
    for(int i = 0; i < DEF_MAXCLIENTS; i++)\par
    \{\par
        if(m_pClientList[i] != NULL)\par
        \{\par
            SendNotifyMsg(NULL, i, DEF_NOTIFY_CAPTURETHEFLAGSTART, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);        \par
        \}\par
    \}\par
    PutLogList("(*) Capture The Flag Started!");\par
\}\par
void CGame::RequestCheckFlag(int iClientH)\par
\{\par
    if(!m_bIsCTFMode) return;\par
    if(m_pClientList[iClientH] == NULL) return;\par
\par
    if(m_pClientList[iClientH]->m_cSide == 0) RequestTeleportHandler(iClientH, "2   ", "default", -1, -1);\par
\par
    if((m_pClientList[iClientH]->m_sX == 151) && (m_pClientList[iClientH]->m_sY == 132))//Elvine Flag Cords\par
    \{\par
        if(m_pClientList[iClientH]->m_iLevel >= 120)\par
        \{\par
            if(m_pClientList[iClientH]->m_cSide == 1) //Aresden Side\par
            \{\par
                if((!m_bIsAresdenFlagCaptured) && (!m_bIsElvineFlagCaptured)) //Aresden Capture Elvine Flag\par
                \{\par
                    PutLogList("Capture The Flag: Aresden Captured Elvine Flag!");\par
                    SetFlagCarrierFlag(iClientH, true);\par
                    \par
                \}\par
            \}\par
            else //Elvine Side\par
            \{\par
                if((m_bIsAresdenFlagCaptured) && (!m_bIsElvineFlagCaptured))\par
                \{\par
                    PutLogList("Capture The Flag: Elvine wins this round!");\par
                    m_sElvineFlagCount++;\par
                    m_bIsAresdenFlagCaptured = false;\par
                    for(int i = 0; i < DEF_MAXCLIENTS; i++) if(m_pClientList[i] != NULL) SendNotifyMsg(NULL, i, DEF_NOTIFY_ELVINEWINSROUND, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);\par
                    if(m_sElvineFlagCount == 5)\par
                    \{\par
                        EndCaptureTheFlag(2);\par
                    \}\par
                \}\par
            \}\par
\par
        \}\par
        else RequestTeleportHandler(iClientH, "2   ", "elvine", -1, -1);\par
    \}\par
    else if((m_pClientList[iClientH]->m_sX == 151) && (m_pClientList[iClientH]->m_sY == 128))//Aresden Flag Cords\par
    \{\par
        if(m_pClientList[iClientH]->m_iLevel >= 120)\par
        \{\par
            if(m_pClientList[iClientH]->m_cSide == 2) //Elvine Side\par
            \{\par
                if((!m_bIsElvineFlagCaptured) && (!m_bIsAresdenFlagCaptured)) //Elvine Capture Aresden Flag\par
                \{\par
                    PutLogList("Capture The Flag: Elvine Captured Aresden Flag!");\par
                    SetFlagCarrierFlag(iClientH, true);\par
                \}\par
            \}\par
            else //Aresden Side\par
            \{\par
                if((m_bIsElvineFlagCaptured) && (!m_bIsAresdenFlagCaptured))\par
                \{\par
                    PutLogList("Capture The Flag: Aresden wins this round!");\par
                    m_sAresdenFlagCount++;\par
                    m_bIsElvineFlagCaptured = false;\par
                    for(int i = 0; i < DEF_MAXCLIENTS; i++) if(m_pClientList[i] != NULL) SendNotifyMsg(NULL, i, DEF_NOTIFY_ARESDENWINSROUND, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);\par
                    if(m_sAresdenFlagCount == 5)\par
                    \{\par
                        EndCaptureTheFlag(1);\par
                    \}\par
                \}\par
            \}\par
        \}\par
        else RequestTeleportHandler(iClientH, "2   ", "aresden", -1, -1);\par
    \}\par
\}\par
BOOL CGame::bCheckIfIsFlagCarrier(int iClientH)\par
\{\par
    if(!m_bIsCTFMode) return false;\par
    if(m_iFlagCarrierIndex == -1) return false;\par
    if(m_pClientList[iClientH] == NULL) return false;\par
\par
    if(iClientH == m_iFlagCarrierIndex) return true;\par
    else return false;\par
\}\par
void CGame::SetFlagCarrierFlag(int iClientH, BOOL bFlagMode) \par
\{      \par
    if(!m_bIsCTFMode) return;\par
    if(m_pClientList[iClientH] == NULL) return;\par
\par
    if(bFlagMode)\par
    \{\par
        PutLogList("Capture The Flag: New Flag Carrier!");\par
        m_iFlagCarrierIndex = iClientH;\par
        if(m_pClientList[iClientH]->m_cSide == 1)\par
        \{\par
            m_bIsElvineFlagCaptured = true;\par
            for(int i = 0; i < DEF_MAXCLIENTS; i++) if(m_pClientList[i] != NULL) SendNotifyMsg(NULL, i, DEF_NOTIFY_ARESDENCAPTUREDELVINEFLAG, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);\par
        \}\par
        else\par
        \{\par
            m_bIsAresdenFlagCaptured = true;\par
            for(int i = 0; i < DEF_MAXCLIENTS; i++) if(m_pClientList[i] != NULL) SendNotifyMsg(NULL, i, DEF_NOTIFY_ELVINEFLAGBACKTOCH, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);\par
        \}\par
        m_pClientList[iClientH]->m_iEnemyKillCount += 20;\par
        SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_ENEMYKILLREWARD, iClientH, NULL, NULL, NULL);\par
        if(m_pClientList[iClientH]->m_cSide == 1) m_pClientList[iClientH]->m_iStatus = m_pClientList[iClientH]->m_iStatus | 0x80000; //Aresden Flag\par
        else if(m_pClientList[iClientH]->m_cSide == 2) m_pClientList[iClientH]->m_iStatus = m_pClientList[iClientH]->m_iStatus | 0x40000; //Elvine Flag\par
    \}\par
    else \par
    \{\par
        PutLogList("Capture The Flag: Flag Carrier Reset.");\par
        m_iFlagCarrierIndex = -1;\par
        if(m_pClientList[iClientH]->m_cSide == 1)\par
        \{\par
            m_bIsElvineFlagCaptured = false;\par
            for(int i = 0; i < DEF_MAXCLIENTS; i++) if(m_pClientList[i] != NULL) SendNotifyMsg(NULL, i, DEF_NOTIFY_ELVINECAPTUREDARESDENFLAG, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);\par
        \}\par
        else\par
        \{\par
            m_bIsAresdenFlagCaptured = false;\par
            for(int i = 0; i < DEF_MAXCLIENTS; i++) if(m_pClientList[i] != NULL) SendNotifyMsg(NULL, i, DEF_NOTIFY_ARESDENFLAGBACKTOCH, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);\par
        \}\par
        m_pClientList[iClientH]->m_iStatus = m_pClientList[iClientH]->m_iStatus | 0x00001000;\par
    \}\par
\}\par
void CGame::EndCaptureTheFlag(int iOption)\par
\{\par
    if(!m_bIsCTFMode) return;\par
    int i;\par
    switch(iOption)\par
    \{\par
        case 0://Finished by GM\par
            for(i = 0; i < DEF_MAXCLIENTS; i++) if(m_pClientList[i] != NULL) SendNotifyMsg(NULL, i, DEF_NOTIFY_TIECTF, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);\par
            _CreateCTFGUID(0);\par
            break;\par
        case 1://Aresden Win\par
            for(i = 0; i < DEF_MAXCLIENTS; i++) if(m_pClientList[i] != NULL) SendNotifyMsg(NULL, i, DEF_NOTIFY_ARESDENWINCTF, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);\par
            _CreateCTFGUID(1);\par
            break;\par
        case 2://Elvine Win\par
            for(i = 0; i < DEF_MAXCLIENTS; i++) if(m_pClientList[i] != NULL) SendNotifyMsg(NULL, i, DEF_NOTIFY_ELVINEWINCTF, NULL, NULL, NULL, NULL,NULL,NULL,NULL,NULL,NULL,NULL, NULL);\par
            _CreateCTFGUID(2);\par
            break;\par
    \}\par
\}\par
void CGame::_CreateCTFGUID(int iWinnerSide)\par
\{\par
 char * cp, cTxt[256], cFn[256], cTemp[1024];    \par
 FILE * pFile;\par
        \par
    _mkdir("GameData");\par
    ZeroMemory(cFn, sizeof(cFn));\par
    \par
    strcat(cFn,"GameData");\par
    strcat(cFn,"\\\\");\par
    strcat(cFn,"\\\\");                      \par
    strcat(cFn,"CTFGUID.Txt");\par
        \par
    pFile = fopen(cFn, "wt");\par
    if (pFile == NULL) \{\par
        PutLogList("(!) Cannot create CTFGUID(%d) file");\par
    \}\par
    else \{\par
        ZeroMemory(cTemp, sizeof(cTemp));\par
        \par
        ZeroMemory(cTxt, sizeof(cTxt));\par
        wsprintf(cTxt, "winner-side = %d\\n", iWinnerSide);\par
        strcat(cTemp, cTxt);\par
        \par
        cp = (char *)cTemp;\par
        fwrite(cp, strlen(cp), 1, pFile);\par
        \par
        PutLogList("(O) CTFGUID(%d) file created");\par
    \}\par
    if (pFile != NULL) fclose(pFile);\par
\}\par
