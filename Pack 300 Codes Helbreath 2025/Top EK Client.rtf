void CGame::calcularTopEkPlayer(int iClientH) // MORLA 2.4 - Calcular si tiene mas EKs\par
\{\par
        char cMsg[255];\par
    ZeroMemory(cMsg, sizeof(cMsg));\par
        int i;\par
        \par
        if      ((m_pClientList[iClientH]->m_iEnemyKillCount > m_iEkTop1) \par
                && (strcmp(m_pClientList[iClientH]->m_cLocation, "aresden") == 0))\par
        \{\par
                m_iEkTop1 = m_pClientList[iClientH]->m_iEnemyKillCount;\par
                ZeroMemory(m_cEkTop1, sizeof(m_cEkTop1));\par
                wsprintf(m_cEkTop1, m_pClientList[iClientH]->m_cCharName);              \par
                for (i = 1; i < DEF_MAXCLIENTS; i++) // Check all clients\par
                \{\par
                        if ((m_pClientList[i] != NULL))  // Check if client is avtice\par
                        \{\par
                                wsprintf(cMsg, "\'a1%s is the new Master of Aresden!", m_pClientList[iClientH]->m_cCharName);\par
                                ShowClientMsg(i, "TopPlayers", cMsg);\par
                                PutLogFileList(cMsg); // Enter into logs\par
                                SendNotifyMsg(NULL, i, DEF_NOTIFY_TOPPLAYERS, 1, m_pClientList[iClientH]->m_iEnemyKillCount, NULL, m_pClientList[iClientH]->m_cCharName);\par
                        \}\par
                \}\par
                \par
        \}\par
        else \{\par
                if      ((m_pClientList[iClientH]->m_iEnemyKillCount > m_iEkTop2) \par
                        && (strcmp(m_pClientList[iClientH]->m_cLocation, "elvine") == 0))\par
                \{\par
