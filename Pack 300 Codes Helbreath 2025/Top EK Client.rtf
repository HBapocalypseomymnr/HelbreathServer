                        aHBTopKills[p] = m_pClientList[iClientH]->m_iEnemyKillCount;\par
                        aHBTopDeaths[p] = m_pClientList[iClientH]->m_iDeaths;\par
                        ZeroMemory(aHBTopClientH[p], sizeof(aHBTopClientH[p]));\par
                        memcpy(aHBTopClientH[p], m_pClientList[iClientH]->m_cCharName, 10);\par
                        bExiste = true;\par
                        ordenarTop15HB(iClientH);\par
                \}\par
        \}\par
        if (bExiste == false)\par
        \{\par
                if(aHBTopKills[15] < m_pClientList[iClientH]->m_iEnemyKillCount)\par
                \{\par
                        aHBTopKills[15] = m_pClientList[iClientH]->m_iEnemyKillCount;\par
                        aHBTopDeaths[15] = m_pClientList[iClientH]->m_iDeaths;\par
                        ZeroMemory(aHBTopClientH[15], sizeof(aHBTopClientH[15]));\par
                        memcpy(aHBTopClientH[15], m_pClientList[iClientH]->m_cCharName, 10);\par
                        ordenarTop15HB(iClientH);\par
                \}\par
        \}\par
\}\par
