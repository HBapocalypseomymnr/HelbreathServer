void CGame::ordenarTop15HB(int iClientH) // MORLA 2.4 - Calcular si tiene mas Deaths\par
\{\par
        char cMsg[255];\par
    ZeroMemory(cMsg, sizeof(cMsg));\par
        int aux1, aux2, p, q, i;\par
        char aux3[10];\par
\par
        for (p=1; p<=14; p++)\par
        \{\par
                for (q=p+1; q<=15; q++)\par
                \{\par
                        if (aHBTopKills[p] < aHBTopKills[q])\par
                        \{\par
                                aux1 = aHBTopKills[p];\par
                                aux2 = aHBTopDeaths[p];\par
                                ZeroMemory(aux3, sizeof(aux3));\par
                                strcpy(aux3, aHBTopClientH[p]);\par
\par
                                aHBTopKills[p] = aHBTopKills[q];\par
                                aHBTopDeaths[p] = aHBTopDeaths[q];\par
                                ZeroMemory(aHBTopClientH[p], sizeof(aHBTopClientH[p]));\par
                                strcpy(aHBTopClientH[p], aHBTopClientH[q]);\par
\par
                                aHBTopKills[q] = aux1;\par
                                aHBTopDeaths[q] = aux2;\par
                                ZeroMemory(aHBTopClientH[q], sizeof(aHBTopClientH[q]));\par
                                strcpy(aHBTopClientH[q], aux3);\par
                        \}\par
                \}\par
        \}\par
        _CreateTopPlayers();\par
        for (i = 0; i < DEF_MAXCLIENTS; i++) // Check all clients\par
        \{\par
                if (m_pClientList[i] != NULL) \{\par
                        //      if (memcmp(m_pClientList[i]->m_cMapName, "deathmach", 9) == 0)\par
                        for (p=1; p<=15; p++)\par
                        \{\par
                                SendNotifyMsg(NULL, i, DEF_NOTIFY_TOP15HB, p, aHBTopKills[p], aHBTopDeaths[p], aHBTopClientH[p]);\par
                        \}\par
                \}\par
        \}\par
\}\par
