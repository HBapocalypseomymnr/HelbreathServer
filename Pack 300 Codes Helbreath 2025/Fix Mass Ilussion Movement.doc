            \{    if( _bCheckMoveable(dX + aX, dY + aY) == TRUE ) return cTmpDir;\par
                else\par
                \{    SetTopMsg( DEF_MSG_GETNEXTMOVEDIR, 5 );\par
                \}\par
            \}else return cTmpDir;\par
    \}    \}\par
\par
    if (m_cPlayerTurn == 1)\par
    for (i = cDir; i >= cDir - 2;i--)\par
    \{    cTmpDir = i;\par
        if (cTmpDir < 1) cTmpDir += 8;\par
        aX = _tmp_cTmpDirX[cTmpDir];\par
        aY = _tmp_cTmpDirY[cTmpDir];\par
        if (((dX + aX) == m_iPrevMoveX) && ((dY + aY) == m_iPrevMoveY) && (m_bIsPrevMoveBlocked == TRUE) && (bMoveCheck == TRUE))\par
        \{    m_bIsPrevMoveBlocked = FALSE;\par
        \}else if (m_pMapData->bGetIsLocateable(dX + aX, dY + aY) == TRUE)\par
        \{    if( m_pMapData->bIsTeleportLoc(dX + aX, dY + aY) == TRUE )\par
            \{    if( _bCheckMoveable(dX + aX, dY + aY) == TRUE ) return cTmpDir;\par
                else\par
                \{    SetTopMsg( DEF_MSG_GETNEXTMOVEDIR, 5 );\par
                \}\par
            \}else return cTmpDir;\par
    \}    \}\par
    return 0;\par
\}\par
