char CGame::cGetNextMoveDir(short sX, short sY, short dstX, short dstY, BOOL bMoveCheck, BOOL bMIM)\par
\{\par
 char  cDir, cTmpDir;\par
 //int   aX, aY, aX2, aY2, dX, dY;\par
 int   aX, aY, dX, dY;\par
 int   i;\par
    if ((sX == dstX) && (sY == dstY)) return 0;\par
    dX = sX;\par
    dY = sY;\par
    if (bMIM == FALSE) // MIM Fix\par
         cDir = m_Misc.cGetNextMoveDir(dX, dY, dstX, dstY);\par
    else cDir = m_Misc.cGetNextMoveDir(dstX, dstY, dX, dY);\par
\par
    if (m_cPlayerTurn == 0)\par
    for (i = cDir; i <= cDir + 2;i++)\par
    \{    cTmpDir = i;\par
        if (cTmpDir > 8) cTmpDir -= 8;\par
        aX = _tmp_cTmpDirX[cTmpDir];\par
        aY = _tmp_cTmpDirY[cTmpDir];\par
        if (((dX + aX) == m_iPrevMoveX) && ((dY + aY) == m_iPrevMoveY) && (m_bIsPrevMoveBlocked == TRUE) && (bMoveCheck == TRUE))\par
        \{    m_bIsPrevMoveBlocked = FALSE;\par
        \}else if (m_pMapData->bGetIsLocateable(dX + aX, dY + aY) == TRUE)\par
