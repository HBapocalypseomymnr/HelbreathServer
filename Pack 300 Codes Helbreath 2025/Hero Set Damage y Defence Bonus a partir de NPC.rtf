    // Added here, with monster count u still have hit ratio and higher too. Maximum is 260.\par
    iAttackerHitRatio += ((m_pClientList[sAttackerH]->m_iMonsterCount/10)+200);\par
    iAP_SM += m_pClientList[sAttackerH]->m_iMonsterCount/10; \par
    iAP_L += m_pClientList[sAttackerH]->m_iMonsterCount/10; \par
    \}\par
iAttackerHitRatio += 100; \par
iAP_SM += 5; \par
iAP_L += 5; \par
\}\par
\par
// Mage Hero Set\par
if (m_pClientList[sAttackerH]->m_cHeroArmourBonus == 2) \par
\{\par
        if(m_pClientList[sAttackerH]->m_iMonsterCount >= 10)\par
        \{\par
        m_pClientList[sAttackerH]->m_iMonsterCount/10;\par
        iDamage += m_pClientList[sAttackerH]->m_iMonsterCount/10;\par
        \}\par
        iDamage += 5;\par
\}\par
\par
// This function is for players who don't have hero armor also can have added damage, but you can put it lower.\par
if (m_pClientList[sAttackerH]->m_iMonsterCount > 0) \par
\{\par
        iDMGCount = m_pClientList[sAttackerH]->m_iMonsterCount/20; // Change from 10 to 20.\par
        iDamage += iDMGCount; // Mage\par
        iAP_SM += iDMGCount;  // Warrior\par
        iAP_L += iDMGCount;    // Warrior\par
\}\par
\par
This can be simplified as well. This way, people with BMage stats wont be able to play around with the added damage, you can put the values higher depending on your server stats.\par
