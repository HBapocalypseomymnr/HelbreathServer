void CGame::DrawDialogBox_ChangeCity(short msX, short msY)\par
\{short sX, sY;\par
\tab sX = m_stDialogBoxInfo[52].sX;\par
\tab sY = m_stDialogBoxInfo[52].sY;\par
\tab DrawNewDialogBox(DEF_SPRID_INTERFACE_ND_GAME1, sX, sY, 2);\par
\tab PutString(sX + 50, sY + 20, "          Do you really", RGB(4,0,50));\par
\tab PutString(sX + 80, sY + 35, "wanna change city?", RGB(4,0,50));\par
\tab if ((msX >= sX + 30) && (msX <= sX + 30 + DEF_BTNSZX) && (msY >= sY + 55) && (msY <= sY + 55 + DEF_BTNSZY)) \par
\tab\{\tab DrawNewDialogBox(DEF_SPRID_INTERFACE_ND_BUTTON, sX + 30, sY + 55 ,19);\par
\tab\}else\par
\tab\{\tab DrawNewDialogBox(DEF_SPRID_INTERFACE_ND_BUTTON, sX + 30, sY + 55 , 18);\par
\tab\}\par
\tab if ((msX >= sX + 170 ) && (msX <= sX + 170 + DEF_BTNSZX ) && (msY >= sY + 55 ) && (msY <= sY + 55 + DEF_BTNSZY)) \par
\tab\{\tab DrawNewDialogBox(DEF_SPRID_INTERFACE_ND_BUTTON, sX + 170 , sY + 55 , 3);\par
\tab\}else\par
\tab\{\tab DrawNewDialogBox(DEF_SPRID_INTERFACE_ND_BUTTON, sX + 170, sY + 55 , 2);\par
\tab\}\par
\}\par
\par
void CGame::DlgBoxClick_ChangeCity(short msX, short msY)\par
\{short sX, sY;\par
\tab sX = m_stDialogBoxInfo[52].sX;\par
\tab sY = m_stDialogBoxInfo[52].sY;\par
\tab if ((msX >= sX + 30) && (msX <= sX + 30 + DEF_BTNSZX) && (msY >= sY + 55) && (msY <= sY + 55 + DEF_BTNSZY)) \par
\tab\{   bSendCommand(DEF_REQUEST_CHANGECITY_YES, 0, 0, 0, 0 ,0, NULL, 0);\par
\tab\tab DisableDialogBox(52);\par
\tab\}else if ((msX >= sX + 170 ) && (msX <= sX + 170 + DEF_BTNSZX ) && (msY >= sY + 55 ) && (msY <= sY + 55 + DEF_BTNSZY)) \par
\tab\{\tab bSendCommand(DEF_REQUEST_CHANGECITY_NO, 0, 0, 0, 0 ,0, NULL, 0);\par
\tab\tab DisableDialogBox(52);\par
\tab\}\par
\}\par
