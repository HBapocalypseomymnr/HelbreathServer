C\'f3digo:\par
void CGame::PlayerRequest_ChangeCity(int iClientH)\par
\{\par
\tab if (m_pClientList[iClientH] == NULL) return;\par
\tab // Centuu : No tiene los majestic's necesarios.\par
\tab if (m_pClientList[iClientH]->m_iGizonItemUpgradeLeft < 200) \{   \par
\tab\tab ShowClientMsg(iClientH, " You don't have 200 Majestic points."); \par
\tab\tab return;\par
\tab\}\par
\tab SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_CHANGECITY, NULL, NULL, NULL, NULL);\par
\}\par
void CGame::PlayerOrder_ChangeCity(int iClientH, BOOL bChange) \par
\{\par
\tab if (m_pClientList[iClientH] == NULL) return;  \par
\tab if (bChange == TRUE) \{ .\par
\tab\tab if (memcmp(m_pClientList[iClientH]->m_cLocation, "aresden", 7) == 0) \{ \par
\tab\tab\tab strcpy(m_pClientList[iClientH]->m_cLocation, "elvine"); \par
\tab\tab\tab ShowClientMsg(iClientH, " Now you're a citizen of Elvine.");\par
\tab\tab\}\par
\tab\tab else if (memcmp(m_pClientList[iClientH]->m_cLocation, "elvine", 6) == 0) \{ \par
\tab\tab\tab strcpy(m_pClientList[iClientH]->m_cLocation, "aresden");  \par
\tab\tab\tab ShowClientMsg(iClientH, " Now you're a citizen of Aresden.");\par
\tab\tab\}\par
\tab\tab m_pClientList[iClientH]->m_iGizonItemUpgradeLeft -= 200;\par
\tab\tab SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_GIZONITEMUPGRADELEFT, NULL, NULL, NULL, NULL);\par
\tab\tab SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_CHANGEPLAYMODE, NULL, NULL, NULL, m_pClientList[iClientH]->m_cLocation);\par
\tab\tab SendEventToNearClient_TypeA(iClientH, DEF_OWNERTYPE_PLAYER, MSGID_EVENT_MOTION, m_pClientList[iClientH]->m_iLevel, NULL, NULL, NULL);\par
\tab\tab ShowClientMsg(iClientH, " Change city successfully.");\par
\tab\}\par
\tab else if (bChange == FALSE) return; .\par
\}\par
