C\'f3digo:\par
void CGame::PlayerOrder_GetPosRep(int iClientH) \{\par
char cRatingIs[256];\par
\par
\{\par
if (m_pClientList[iClientH]->m_iGizonItemUpgradeLeft > 0) \{\par
m_pClientList[iClientH]->m_iRating += 10;\par
m_pClientList[iClientH]->m_iGizonItemUpgradeLeft -= 100;\par
ShowClientMsg( iClientH , "Your reputation increased by 10");\par
wsprintf(cRatingIs ,"Your Total Rep is: %d ",  m_pClientList[iClientH]->m_iRating);\par
ShowClientMsg( iClientH , cRatingIs );\par
\}\par
\}\par
\}\par
void CGame::PlayerOrder_GetNegRep(int iClientH) \{\par
char cRatingIs[256];\par
\par
\{\par
if (m_pClientList[iClientH]->m_iGizonItemUpgradeLeft > 0) \{\par
m_pClientList[iClientH]->m_iRating -= 10;\par
m_pClientList[iClientH]->m_iGizonItemUpgradeLeft -= 100;\par
ShowClientMsg( iClientH , "Your reputation decreased by 10");\par
wsprintf(cRatingIs ,"Your Total Rep is now: %d ", m_pClientList[iClientH]->m_iRating);\par
ShowClientMsg( iClientH , cRatingIs );\par
\}\par
\}\par
\}\par
