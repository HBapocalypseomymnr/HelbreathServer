void CGame::ReadCharConfigFile(char * cFn, char * cSa, char * cSb, char *name, long *x, long *y)\par
\{    FILE * pFile;\par
    HANDLE hFile;\par
    DWORD  dwFileSize;\par
    char * cp, * token, cReadMode, cGSMode[16] = "";\par
    char seps[] = "= \\t\\n";    \par
    class CStrTok * pStrTok;\par
    cReadMode = 0;\par
    hFile = CreateFile(cFn, GENERIC_READ, NULL, NULL, OPEN_EXISTING, NULL, NULL);\par
    dwFileSize = GetFileSize(hFile, NULL);\par
    if (hFile != INVALID_HANDLE_VALUE) \par
        CloseHandle(hFile);\par
\par
\par
    pFile = fopen(cFn, "rt");\par
    if (pFile == NULL) \{\par
        return;\par
    \}\par
    else \{\par
        cp = new char[dwFileSize+2];\par
        ZeroMemory(cp, dwFileSize+2);\par
        fread(cp, dwFileSize, 1, pFile);\par
\par
\par
        pStrTok = new class CStrTok(cp, seps);\par
        token = pStrTok->pGet();\par
        while( token != NULL )\{\par
            if (cReadMode != 0)\{\par
                switch (cReadMode)\{\par
                case 1:\par
                    ZeroMemory(name, sizeof(name));\par
                    memcpy(name, token, strlen(token));\par
                    cReadMode = 0;\par
                    break;\par
                case 2:\par
                    *x = atoi(token);\par
                    cReadMode = 0;\par
                    break;\par
                case 3:\par
                    *y = atoi(token);\par
                    cReadMode = 0;\par
                    break;\par
                \}\par
            \}\par
            else \{\par
                if (memcmp(token, "character-name", strlen("character-name")) == 0)\par
                    cReadMode = 1;\par
                if (memcmp(token, cSa, strlen(cSa)) == 0)\par
                    cReadMode = 2;\par
                if (memcmp(token, cSb, strlen(cSb)) == 0)\par
                    cReadMode = 3;\par
            \}\par
            token = pStrTok->pGet();\par
        \}\par
        delete pStrTok;\par
        delete cp;\par
    \}\par
    if (pFile != NULL) fclose(pFile);\par
\}\par
