m_pClientList[iClientH]->m_ItemPosList[iItemIndex].x = iItemX;\par
m_pClientList[iClientH]->m_ItemPosList[iItemIndex].y = iItemY;\par
if (_bInitItemAttr(m_pClientList[iClientH]->m_pItemList[iItemIndex], 2002) == FALSE) \{ // BlackKnightBarHammer \par
SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_ITEMATTRIBUTECHANGE, iItemIndex, m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_dwAttribute, NULL, NULL);\par
return;\par
\}\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sTouchEffectType = DEF_ITET_UNIQUE_OWNER;\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sTouchEffectValue1 = m_pClientList[iClientH]->m_sCharIDnum1;\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sTouchEffectValue2 = m_pClientList[iClientH]->m_sCharIDnum2;\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sTouchEffectValue3 = m_pClientList[iClientH]->m_sCharIDnum3;\par
iValue += 2;\par
if (iValue > 15) iValue = 15;\par
dwTemp = m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_dwAttribute;\par
dwTemp = dwTemp & 0x0FFFFFFF;\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_dwAttribute = dwTemp | (iValue << 28);\par
SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_GIZONITEMCANGE, iItemIndex, \par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_cItemType,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_wCurLifeSpan, \par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_cName,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sSprite,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sSpriteFrame,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_cItemColor,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sItemSpecEffectValue2,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_dwAttribute );\par
_bItemLog(DEF_ITEMLOG_UPGRADESUCCESS, iClientH, (int) -1, m_pClientList[iClientH]->m_pItemList[iItemIndex]); \par
\}\par
else if ((iValue >= 12) && (m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sIDnum == 2002)) \{ // BlackKnightBarHammer \par
iValue += 2;\par
if (iValue > 15) iValue = 15;\par
if (iValue == 15) m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_cItemColor = 9;\par
dwTemp = m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_dwAttribute;\par
dwTemp = dwTemp & 0x0FFFFFFF;\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_dwAttribute = dwTemp | (iValue << 28);\par
SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_ITEMATTRIBUTECHANGE, iItemIndex, m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_dwAttribute, NULL, NULL);\par
SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_GIZONITEMCANGE, iItemIndex, \par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_cItemType,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_wCurLifeSpan, \par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_cName,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sSprite,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sSpriteFrame,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_cItemColor,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_sItemSpecEffectValue2,\par
m_pClientList[iClientH]->m_pItemList[iItemIndex]->m_dwAttribute );\par
_bItemLog(DEF_ITEMLOG_UPGRADESUCCESS, iClientH, (int) -1, m_pClientList[iClientH]->m_pItemList[iItemIndex]); \par
\}\par
\par
y listo, solo agreguen esos 3 items a su item3.cfg y ya podran tener su dkhammer+15\par
\par
Code:\par
\par
C\'f3digo:\par
\par
Item = 2000 BlackKnightHammer 1 9 1 3 7 0 3 9 0 30000 0 15 7 6000 9000 30 12 180 0 0 0 14 1 6\par
Item = 2001 BlackKnightBHammer 1 9 1 3 7 2 3 9 2 30000 0 15 8 9000 12000 31 14 180 0 0 0 14 1 6\par
Item = 2002 BlackKnightBarHammer 1 9 1 3 9 2 3 10 2 30000 0 15 10 15000 20000 32 15 180 0 0 0 14 1 6\par
\par
\par
\par
Si envez de un hammer quieren una axe solo editen los IDs del code...\par
}
