void CGame::AdminOrder_SetCrit (int iClientH, char *pData, DWORD dwMsgSize)\par
\{\par
char seps[] = "= \\t\\n";\par
char *token, cBuff[256];\par
class CStrTok *pStrTok;\par
char *pk;\par
char cNick[20];\par
char cPK[5];\par
char notice[100];\par
int oldpk;\par
int i;\par
if (m_pClientList[iClientH] == NULL)\par
return;\par
if ((dwMsgSize) <= 0)\par
return;\par
if (m_pClientList[iClientH]->m_iAdminUserLevel == 0)\par
\{\par
SendNotifyMsg (NULL, iClientH, DEF_NOTIFY_ADMINUSERLEVELLOW, NULL, NULL,\par
NULL, NULL);\par
return;\par
\}\par
ZeroMemory (cBuff, sizeof (cBuff));\par
memcpy (cBuff, pData, dwMsgSize);\par
pStrTok = new class CStrTok (cBuff, seps);\par
token = pStrTok->pGet ();\par
token = pStrTok->pGet ();\par
if (token == NULL)\par
\{\par
delete pStrTok;\par
return;\par
\}\par
strcpy (cNick, token);\par
pk = pStrTok->pGet ();\par
if (pk == NULL)\par
\{\par
delete pStrTok;\par
return;\par
\}\par
strcpy (cPK, pk);\par
for (i = 0; i < DEF_MAXCLIENTS; i++)\par
\{\par
if ((m_pClientList[i] != NULL)\par
&& (memcmp (m_pClientList[i]->m_cCharName, cNick, strlen (cNick)) == 0))\par
\{\par
oldpk = m_pClientList[i]->m_iSuperAttackLeft;\par
m_pClientList[i]->m_iSuperAttackLeft = atoi (cPK);\par
SendNotifyMsg (NULL, i, DEF_NOTIFY_SUPERATTACKLEFT, m_pClientList[i]->m_iSuperAttackLeft, NULL, NULL, NULL);\par
wsprintf (notice, "Crit Count has been changed for player %s from %d to %d.", m_pClientList[iClientH]->m_cCharName, oldpk, atoi (cPK));\par
\}\par
\}\par
delete pStrTok;\par
\}\par
