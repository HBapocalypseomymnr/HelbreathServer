//ShowDefense coded by Magn0S for Helbreath Friend's.\par
void CGame::PlayerOrder_ShowDefense(int iClientH)\par
\{\par
char cDefenseMod[256];\par
\par
\tab if (m_pClientList[iClientH] == NULL) return;\par
\tab\par
\tab // Compute MR / DR\par
\tab int iTargetMagicResistRatio = m_pClientList[iClientH]->m_cSkillMastery[3] + m_pClientList[iClientH]->m_iAddMR;\par
\tab\par
\tab if ((m_pClientList[iClientH]->m_iMag + m_pClientList[iClientH]->m_iAddMag) > 50) \{\par
\tab\tab iTargetMagicResistRatio += ((m_pClientList[iClientH]->m_iMag + m_pClientList[iClientH]->m_iAddMag) - 50);\par
\tab\tab iTargetMagicResistRatio += m_pClientList[iClientH]->m_iAddResistMagic; \par
\tab\}\par
\tab  \par
\tab int iDefRatio = m_pClientList[iClientH]->m_iDefenseRatio + m_pClientList[iClientH]->m_iAddDR;\par
\tab wsprintf(cDefenseMod ,"Resistences: DR: %d - MR: %d", iDefRatio, iTargetMagicResistRatio);\par
\tab SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_NOTICEMSG, NULL, NULL, NULL, cDefenseMod);\par
\par
\tab //Compute MA / PA\par
\tab int iPAHelm = m_pClientList[iClientH]->m_iDamageAbsorption_Armor[DEF_EQUIPPOS_HEAD];\par
\tab int iPAArmor = (m_pClientList[iClientH]->m_iDamageAbsorption_Armor[DEF_EQUIPPOS_PANTS] + m_pClientList[iClientH]->m_iDamageAbsorption_Armor[DEF_EQUIPPOS_LEGGINGS])\tab ;\par
\tab int iPABerk = m_pClientList[iClientH]->m_iDamageAbsorption_Armor[DEF_EQUIPPOS_ARMS];\par
\tab int iPALeggs = m_pClientList[iClientH]->m_iDamageAbsorption_Armor[DEF_EQUIPPOS_PANTS];\par
\par
\tab wsprintf(cDefenseMod ,"Absorptions: PA: (Helm: %d - Body: %d - Hauberk: %d - Leggs: %d) -  MA: %d", iPAHelm, iPAArmor, iPABerk, iPALeggs, m_pClientList[iClientH]->m_iAddAbsMD);\par
\tab SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_NOTICEMSG, NULL, NULL, NULL, cDefenseMod);\par
\par
\tab //Compute MA / PA\par
\tab wsprintf(cDefenseMod ,"Attacks: Hit Ratio: %d - Physical: %d - Magical: %d", m_pClientList[iClientH]->m_iHitRatio, m_pClientList[iClientH]->m_iAddPhysicalDamage, m_pClientList[iClientH]->m_iAddMagicalDamage);\par
\tab SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_NOTICEMSG, NULL, NULL, NULL, cDefenseMod);\par
\par
\par
\}\par
