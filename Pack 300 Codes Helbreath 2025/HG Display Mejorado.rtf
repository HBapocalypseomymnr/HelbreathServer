{\*\generator Msftedit 5.41.15.1515;}\viewkind4\uc1\pard\f0\fs20 Este code no es mas que un code estetico para los administradores del server, en que muestra, basciamente, informacion sobre el HG.\par
\par
Pueden ver como queda en la siguiente imagen, como veran, se agrego el max stats, simplifico el players(X/Y), se agrego un total maps y total obj, y saco el de crusade. Ademas en la parte de abajo, antes, al tener muchos mapas(mas de 11), la info se cortaba, ahora se muestra en columnas de 11 mapas.\par
\par
\par
Tambien modifique el title, mostrando el tiempo en que se ejecuto el HG mas ordenado.\par
\par
Bueno, para empezar, vayan a los SRC de su HG, y en el archivo Game.cpp, busquen el metodo:\par
C\'f3digo:\par
void CGame::DisplayInfo(HDC hdc)\par
y lo remplazan completamente por este otro:\par
C\'f3digo:\par
void CGame::DisplayInfo(HDC hdc)\par
\{\par
 char cTxt[350];  \par
 int  i, iLineX = 0, iLineY = 0;\par
 char cTotalMaps = 0;\par
 short cTotalActiveObjects = 0;\par
\par
//#ifdef DEF_JAVAMYSQLMODE\par
    ZeroMemory(cTxt, sizeof(cTxt));\par
    strcpy(cTxt, "********** JAVA + MYSQL SERVER MODE **********");\par
    TextOut(hdc, 100, 25, cTxt, strlen(cTxt));\par
//#endif\par
\par
    for(i = 0; i < DEF_MAXMAPS; i++)\par
        if(m_pMapList[i] != NULL)\par
        \{            \par
            ZeroMemory(G_cTxt, sizeof(G_cTxt));\par
            wsprintf(G_cTxt, "Map(%s)", m_pMapList[i]->m_cName);\par
            TextOut(hdc, 5 + (iLineX * 200), 400 + (iLineY * 15), G_cTxt, strlen(G_cTxt));\par
            ZeroMemory(G_cTxt, sizeof(G_cTxt));\par
            wsprintf(G_cTxt, "Object(%04d)", m_pMapList[i]->m_iTotalActiveObject);\par
            TextOut(hdc, 120 + (iLineX * 200), 400 + (iLineY * 15), G_cTxt, strlen(G_cTxt));\par
            \par
            cTotalMaps++;\par
            cTotalActiveObjects += m_pMapList[i]->m_iTotalActiveObject;\par
            \par
            iLineY++;\par
            if(iLineY > 10)\par
            \{\par
                iLineX++;\par
                iLineY = 0;\par
            \}\par
        \}\par
\par
    ZeroMemory(cTxt, sizeof(cTxt));\par
    wsprintf(cTxt, "Server-Name(%s) Max.Level(%d) Max.Stats(%d) Players(%d/%d) T.Maps(%02d) T.Objects(%04d) SLSock(%d:%d) GTSock(%d)", m_cServerName, m_iPlayerMaxLevel, m_sCharStatLimit, m_iTotalClients, m_iMaxClients, cTotalMaps, cTotalActiveObjects, m_iSubLogSockActiveCount, m_iSubLogSockFailCount, m_iGateSockConnRetryTimes);\par
    TextOut(hdc, 5, 10, cTxt, strlen(cTxt));\par
\}\par
Luego vayan al archivo wmain.cpp, y busquen:\par
C\'f3digo:\par
wsprintf(cTitle,\par
y remplacen esa linea por:\par
C\'f3digo:\par
//50Cent - Ordenado executed time\par
wsprintf(cTitle, "Helbreath GameServer V%s.%s %d (Executed: %02d:%02d - %02d/%02d/%d)", DEF_UPPERVERSION, DEF_LOWERVERSION, DEF_BUILDDATE, SysTime.wHour, SysTime.wMinute, SysTime.wDay, SysTime.wMonth, SysTime.wYear);\par
y eso seria todo \par
\par
