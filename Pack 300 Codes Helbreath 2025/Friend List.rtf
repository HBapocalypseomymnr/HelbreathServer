token = pStrTok->pGet();\par
\par
token = pStrTok->pGet();\par
if (token == NULL) \{\par
delete pStrTok;\par
return;\par
\}\par
\par
if (strlen(token) > 10) \{\par
memcpy(cPlayerName,token,10);\par
\}\par
else\{\par
memcpy(cPlayerName,token,strlen(token));\par
\}\par
\par
if((m_pClientList[iClientH]->m_iTotalFriends + 1) >= DEF_MAXFRIENDS)\par
\{\par
ShowClientMsg(iClientH, "Limite maximo de amigos alcansado.");\par
