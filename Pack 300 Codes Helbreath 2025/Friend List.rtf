if ((dwMsgSize)\tab <= 0) return;\par
\par
ZeroMemory(cPlayerName, sizeof(cPlayerName));\par
ZeroMemory(cBuff, sizeof(cBuff));\par
memcpy(cBuff, pData, dwMsgSize);\par
\par
