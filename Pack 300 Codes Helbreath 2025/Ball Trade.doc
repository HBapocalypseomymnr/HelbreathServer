~~~At the bottom of Game.cpp add the function which actually reads the file: \par
BOOL CGame::bReadBallSystemConfigFile(char * cFn) \par
\{ \par
FILE * pFile; \par
HANDLE hFile; \par
DWORD dwFileSize; \par
char * cp, * token, cReadModeA, cReadModeB; \par
char seps[] = "= \\t\\n"; \par
int iIndex; \par
class CStrTok * pStrTok; \par
char cTxt[41]; \par
cReadModeA = 0; \par
cReadModeB = 0; \par
hFile = CreateFile(cFn, GENERIC_READ, NULL, NULL, OPEN_EXISTING, NULL, NULL); \par
dwFileSize = GetFileSize(hFile, NULL); \par
if (hFile != INVALID_HANDLE_VALUE) CloseHandle(hFile); \par
pFile = fopen(cFn, "rt"); \par
if (pFile == NULL) \{ \par
PutLogList("(!) Cannot open Ball System configuration file."); \par
return FALSE; \par
\} \par
else \{ \par
PutLogList("(!) Reading Ball System configuration file..."); \par
cp = new char[dwFileSize+2]; \par
ZeroMemory(cp, dwFileSize+2); \par
fread(cp, dwFileSize, 1, pFile); \par
iIndex = 0; \par
pStrTok = new class CStrTok(cp, seps); \par
token = pStrTok->pGet(); \par
while( token != NULL ) \{ \par
if (cReadModeA != 0) \{ \par
switch (cReadModeA) \{ \par
case 1: \par
switch (cReadModeB) \{ \par
case 1: \par
if (_bGetIsStringIsNumber(token) == FALSE) \{ \par
PutLogList("(!!!) CRITICAL ERROR! Ball System configuration file error - Wrong Data format(1)."); \par
delete cp; \par
delete pStrTok; \par
return FALSE; \par
\} \par
iIndex = atoi(token); \par
if (m_pBallItemConfigList[iIndex] != NULL) \{ \par
wsprintf(cTxt, "(!!!) CRITICAL ERROR! Duplicate Ball Item ID (%d)", iIndex); \par
PutLogList(cTxt); \par
delete pStrTok; \par
return FALSE; \par
\} \par
m_pBallItemConfigList[iIndex] = new class CBallSystem; \par
m_pBallItemConfigList[iIndex]->m_sBS_ID = iIndex; \par
cReadModeB = 2; \par
break; \par
case 2: \par
ZeroMemory(m_pBallItemConfigList[iIndex]->m_cName, sizeof(m_pBallItemConfigList[iIndex]->m_cName)); \par
memcpy(m_pBallItemConfigList[iIndex]->m_cName, token, strlen(token)); \par
cReadModeB = 3; \par
break; \par
case 3: \par
m_pBallItemConfigList[iIndex]->m_iReqPoints = atoi(token); \par
cReadModeA = 0; \par
cReadModeB = 0; \par
\} \par
break; \par
default: \par
break; \par
\} \par
\} \par
else \{ \par
if (memcmp(token, "Ball-Item", 9) == 0) \{ \par
cReadModeA = 1; \par
cReadModeB = 1; \par
\} \par
\} \par
token = pStrTok->pGet(); \par
\} \par
delete pStrTok; \par
delete cp; \par
if ((cReadModeA != 0) || (cReadModeB != 0)) \{ \par
PutLogList("(!!!) CRITICAL ERROR! Ball System configuration file contents error!"); \par
return FALSE; \par
\} \par
\} \par
if (pFile != NULL) fclose(pFile); \par
return TRUE; \par
\} \par
\par
~~~~Now the command which lets a player obtain items! \par
if (memcmp(cp, "/trade ", 7) == 0) \{ \par
RequestBallItem(iClientH, cp, dwMsgSize - 21); \par
return; \par
\} \par
\par
~~~~Function which gets to be actived: \par
void CGame::RequestBallItem(int iClientH, char *pData, DWORD dwMsgSize) \par
\{ \par
char seps[] = "= \\t\\n"; \par
char * cp, * token, cBuff[256], cWantedItemName[256], cData[256], cInfoString[56]; \par
class CStrTok * pStrTok; \par
class CItem * pItem; \par
short * sp, sCounter; \par
int i, iRet, iEraseReq; \par
DWORD * dwp; \par
WORD * wp; \par
if (m_pClientList[iClientH] == NULL) return; \par
if ((dwMsgSize) <= 0) return; \par
ZeroMemory(cBuff, sizeof(cBuff)); \par
memcpy(cBuff, pData, dwMsgSize); \par
pStrTok = new class CStrTok(cBuff, seps); \par
token = pStrTok->pGet(); \par
token = pStrTok->pGet(); \par
if (token != NULL) \{ \par
ZeroMemory(cWantedItemName, sizeof(cWantedItemName)); \par
strcpy(cWantedItemName, token); \par
\} \par
sCounter = 1; \par
for (i = 0, i < DEF_MAXBALLITEMS; i++ \{ \par
if (sCounter == 1) \{ \par
if (m_pBallItemConfigList[i] != NULL) \{ \par
if (strcmp(cWantedItemName, m_pBallItemConfigList[i]->m_cName) == 0) \{ \par
if (m_pClientList[iClientH]->m_iBallPoints < m_pBallItemConfigList[i]->m_iReqPoints) \{ \par
wsprintf(cInfoString,"Item (%s) cannot be traded, not enough points. ", cWantedItemName); \par
SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_IPACCOUNTINFO, NULL, NULL, NULL, cInfoString); \par
return; \par
\} \par
m_pClientList[iClientH]->m_iBallPoints -= m_pBallItemConfigList[i]->m_iReqPoints; \par
pItem = new class CItem; \par
if (_bInitItemAttr(pItem, cWantedItemName) == FALSE) \{ \par
delete pItem; \par
return; \par
\} \par
ZeroMemory(cData, sizeof(cData)); \par
if (_bAddClientItemList(iClientH, pItem, &iEraseReq) == TRUE) \{ \par
dwp = (DWORD *)(cData + DEF_INDEX4_MSGID); \par
*dwp = MSGID_NOTIFY; \par
wp = (WORD *)(cData + DEF_INDEX2_MSGTYPE); \par
*wp = DEF_NOTIFY_ITEMOBTAINED; \par
cp = (char *)(cData + DEF_INDEX2_MSGTYPE + 2); \par
*cp = 1; \par
cp++; \par
memcpy(cp, pItem->m_cName, 20); \par
cp += 20; \par
dwp = (DWORD *)cp; \par
*dwp = pItem->m_dwCount; \par
cp += 4; \par
*cp = pItem->m_cItemType; \par
cp++; \par
*cp = pItem->m_cEquipPos; \par
cp++; \par
*cp = (char)0; \par
cp++; \par
sp = (short *)cp; \par
*sp = pItem->m_sLevelLimit; \par
cp += 2; \par
*cp = pItem->m_cGenderLimit; \par
cp++; \par
wp = (WORD *)cp; \par
*wp = pItem->m_wCurLifeSpan; \par
cp += 2; \par
wp = (WORD *)cp; \par
*wp = pItem->m_wWeight; \par
cp += 2; \par
sp = (short *)cp; \par
*sp = pItem->m_sSprite; \par
cp += 2; \par
sp = (short *)cp; \par
*sp = pItem->m_sSpriteFrame; \par
cp += 2; \par
*cp = pItem->m_cItemColor; \par
cp++; \par
*cp = (char)pItem->m_sItemSpecEffectValue2; \par
cp++; \par
dwp = (DWORD *)cp; \par
*dwp = pItem->m_dwAttribute; \par
cp += 4; \par
if (iEraseReq == 1) \{ \par
delete pItem; \par
pItem = NULL; \par
\} \par
iRet = m_pClientList[iClientH]->m_pXSock->iSendMsg(cData, 53); \par
sCounter = 0; \par
return; \par
\} \par
else \{ \par
sCounter = 0; \par
delete pItem; \par
return; \par
\} \par
\} \par
\} \par
\} \par
\} \par
\} \par
\par
~~~~And at last.. a command which shows a player his amount of Ball Points: \par
if (memcmp(cp, "/ballpoint", 10) == 0) \{ \par
char cInfoString[50]; \par
wsprintf(cInfoString," Amount of Ball Points: (%d) ", m_pClientList[iClientH]->m_iBallPoints); \par
SendNotifyMsg(NULL, iClientH, DEF_NOTIFY_IPACCOUNTINFO, NULL, NULL, NULL, cInfoString); \par
return; \par
\} \par
