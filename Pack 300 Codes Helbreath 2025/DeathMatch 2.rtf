//50Cent - DeathMatch\par
void CGame::DeathMatchProcess(int iAttacker, int iVictim)\par
\{\par
    if(memcmp(m_pMapList[m_pClientList[iAttacker]->m_cMapIndex]->m_cName, "fightzone2", 10) == 0)\par
    \{\par
        m_pClientList[iAttacker]->m_iDeathMatchKills++;\par
        m_pClientList[iAttacker]->m_iMP = iGetMaxMP(iAttacker);\par
        m_pClientList[iAttacker]->m_iSuperAttackLeft = (m_pClientList[iAttacker]->m_iLevel / 10);\par
        SendNotifyMsg(NULL, iAttacker, DEF_NOTIFY_SUPERATTACKLEFT, NULL, NULL, NULL, NULL);\par
        \par
        m_pClientList[iVictim]->m_iDeathMatchDeaths++;\par
        SendNotifyMsg(NULL, iVictim, DEF_NOTIFY_RESURRECTPLAYER, NULL, NULL, NULL, NULL);\par
        SendNotifyMsg(NULL, iAttacker, DEF_NOTIFY_DEATHMATCHDATA, m_pClientList[iAttacker]->m_iDeathMatchKills, m_pClientList[iAttacker]->m_iDeathMatchDeaths, NULL, NULL);\par
        SendNotifyMsg(NULL, iVictim, DEF_NOTIFY_DEATHMATCHDATA, m_pClientList[iVictim]->m_iDeathMatchKills, m_pClientList[iVictim]->m_iDeathMatchDeaths, NULL, NULL);\par
        UpdateDeathMatch(-1);\par
    \}\par
\}\par
void CGame::UpdateDeathMatch(int iClientH)\par
\{\par
    ComposeDeathMatchTopList(iClientH);\par
\par
    for(int i = 0; i < DEF_MAXCLIENTS; i++)\par
    \{\par
        if(m_pClientList[i] != NULL)\par
        \{\par
            if(memcmp(m_pMapList[m_pClientList[i]->m_cMapIndex]->m_cName, "fightzone2", 10) == 0)\par
            \{\par
                SendNotifyMsg(NULL, i, DEF_NOTIFY_DEATHMATCHTOP, NULL, NULL, NULL, NULL);\par
            \}\par
        \}\par
    \}\par
\}\par
\par
void CGame::ComposeDeathMatchTopList(int iClientH)\par
\{\par
    int iIndex = 0;\par
    for(int i = 0; i < DEF_MAXCLIENTS; i++)\par
    \{\par
        if(m_pClientList[i] != NULL)\par
        \{\par
            if(iClientH == i) continue;\par
            if(iIndex == 300) break;\par
            if(memcmp(m_pMapList[m_pClientList[i]->m_cMapIndex]->m_cName, "fightzone2", 10) == 0)\par
            \{\par
                memcpy(m_stDeathMatchTop[iIndex].cDeathMatchTopName, m_pClientList[i]->m_cCharName, 11);\par
                m_stDeathMatchTop[iIndex].iDeathMatchTopKills = m_pClientList[i]->m_iDeathMatchKills;\par
                m_stDeathMatchTop[iIndex].iDeathMatchTopDeaths = m_pClientList[i]->m_iDeathMatchDeaths;\par
                iIndex++;\par
            \}\par
        \}\par
    \}\par
    char cTempName[11];\par
    int iTempKills, iTempDeaths;\par
    for(i = 0; i < 300; i++)\par
    \{\par
        for(int j = 0; j < 300; j++)\par
        \{\par
            if(m_stDeathMatchTop[i].iDeathMatchTopKills >= m_stDeathMatchTop[j].iDeathMatchTopKills)\par
            \{\par
                memcpy(cTempName, m_stDeathMatchTop[i].cDeathMatchTopName, 11);\par
                iTempKills = m_stDeathMatchTop[i].iDeathMatchTopKills;\par
                iTempDeaths = m_stDeathMatchTop[i].iDeathMatchTopDeaths;\par
\par
                memcpy(m_stDeathMatchTop[i].cDeathMatchTopName, m_stDeathMatchTop[j].cDeathMatchTopName, 11);\par
                memcpy(m_stDeathMatchTop[j].cDeathMatchTopName, cTempName, 11);\par
\par
                m_stDeathMatchTop[i].iDeathMatchTopKills = m_stDeathMatchTop[j].iDeathMatchTopKills;\par
                m_stDeathMatchTop[j].iDeathMatchTopKills = iTempKills;\par
\par
                m_stDeathMatchTop[i].iDeathMatchTopDeaths = m_stDeathMatchTop[j].iDeathMatchTopDeaths;\par
                m_stDeathMatchTop[j].iDeathMatchTopDeaths = iTempDeaths;\par
            \}\par
        \}\par
    \}\par
\}\par
