BOOL CGame::bDecodeBallTrade(char *pFn)\par
\{FILE * pFile;\par
HANDLE hFile;\par
DWORD dwFileSize;\par
char * cp, * token, cReadModeA, cReadModeB;\par
char seps[] = "= \\t\\n";\par
class CStrTok * pStrTok;\par
int iIndex;\par
int iBallTradeConfigListIndex;\par
for (int i = 0; i < DEF_MAXBALLTRADE; i++)\par
if (m_pBallTradeConfigList[i] != NULL)\par
\{ delete m_pBallTradeConfigList[i];\par
m_pBallTradeConfigList[i] = NULL;\par
\}\par
cReadModeA = 0;\par
cReadModeB = 0;\par
iIndex = 0;\par
hFile = CreateFile(pFn, GENERIC_READ, NULL, NULL, OPEN_EXISTING, NULL, NULL);\par
dwFileSize = GetFileSize(hFile, NULL);\par
if (hFile != INVALID_HANDLE_VALUE) CloseHandle(hFile);\par
pFile = fopen(pFn, "rt");\par
if (pFile == NULL)\par
\{ PutLogList("(!) Cannot open BallTrade.cfg file.");\par
return FALSE;\par
\}else\par
\{ PutLogList("(!) Reading BallTrade.cfg...");\par
cp = new char[dwFileSize+2];\par
ZeroMemory(cp, dwFileSize+2);\par
fread(cp, dwFileSize, 1, pFile);\par
pStrTok = new class CStrTok(cp, seps);\par
token = pStrTok->pGet();\par
while( token != NULL )\par
\{ if (cReadModeA != 0)\par
\{ switch (cReadModeA) \{\par
case 1:\par
switch (cReadModeB) \{\par
case 1: // BallTrade n\'b0\par
if (_bGetIsStringIsNumber(token) == FALSE)\par
\{ PutLogList("(!!!) CRITICAL ERROR! BallTrade configuration file error - Wrong Data format.");\par
delete pStrTok; delete cp; return FALSE;\par
\}\par
iBallTradeConfigListIndex = atoi(token);\par
if ((iBallTradeConfigListIndex < 0) || (iBallTradeConfigListIndex >= DEF_MAXBALLTRADE))\par
\{ PutLogList("(!!!) CRITICAL ERROR! BallTrade configuration file error - Wrong BallTrade number.");\par
return FALSE;\par
\}\par
if (m_pBallTradeConfigList[iBallTradeConfigListIndex] != NULL)\par
\{ PutLogList("(!!!) CRITICAL ERROR! BallTrade configuration file error - Duplicate BallTrade number.");\par
return FALSE;\par
\}\par
m_pBallTradeConfigList[iBallTradeConfigListIndex] = new class CBallTrade;\par
cReadModeB = 2;\par
break;\par
case 2:\par
ZeroMemory(m_pBallTradeConfigList[iBallTradeConfigListIndex]->m_cName, sizeof(m_pBallTradeConfigList[iBallTradeConfigListIndex]->m_cName));\par
memcpy(m_pBallTradeConfigList[iBallTradeConfigListIndex]->m_cName, token, strlen(token));\par
PutLogList(token);\par
\par
\par
cReadModeB = 3;\par
break;\par
\par
case 3:\par
if (_bGetIsStringIsNumber(token) == FALSE)\par
\{ PutLogList("(!!!) CRITICAL ERROR! BallTrade configuration file error - MaxLvl- Wrong Data format.");\par
delete cp; delete pStrTok; return FALSE;\par
\}\par
m_pBallTradeConfigList[iBallTradeConfigListIndex]->m_iReqPoints = atoi(token);\par
PutLogList(token);\par
cReadModeA = 0;\par
cReadModeB = 0;\par
break;\par
\}\par
break;\par
default:\par
break;\par
\}\par
\}else\par
\{ if (memcmp(token, "balltrade", 9) == 0)\par
\{ cReadModeA = 1;\par
cReadModeB = 1;\par
\}else if (memcmp(token, "[END]", 5) == 0)\par
\{ cReadModeA = 0;\par
cReadModeB = 0;\par
break; // Stop While Loop\par
\}\par
\}\par
token = pStrTok->pGet();\par
\} // while\par
delete pStrTok; delete cp;\par
if ((cReadModeA != 0) || (cReadModeB != 0)||(iBallTradeConfigListIndex < 0)||(iBallTradeConfigListIndex >= DEF_MAXBALLTRADE))\par
\{ PutLogList("(!!!) CRITICAL ERROR! BallTrade configuration file contents error!");\par
return FALSE;\par
\}\par
if (pFile != NULL) fclose(pFile);\par
wsprintf(G_cTxt, "(!) BallTrade(Total:%d) configuration - success!", iBallTradeConfigListIndex);\par
PutLogList(G_cTxt);\par
return TRUE;\par
\}\par
\}\par
