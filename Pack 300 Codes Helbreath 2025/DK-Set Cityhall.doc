case 13: //ZeroEoyPnk - code original drajwer - modificado para los DK items \par
PutAlignedString(sX,sX+szX-1,sY+125,m_cTakeDKItemName, 55,25,25);\par
PutAlignedString(sX+1,sX+szX,sY+125,m_cTakeDKItemN ame, 55,25,25);\par
PutAlignedString(sX,sX+szX,sY+260,DRAW_DIALOGBOX_C ITYHALL_MENU46A, 55,25,25); // would you like..\par
if ( (msX >= sX + DEF_LBTNPOSX) && (msX <= sX + DEF_LBTNPOSX + DEF_BTNSZX)\par
&& (msY >= sY + DEF_BTNPOSY) && (msY <= sY + DEF_BTNPOSY + DEF_BTNSZY))\par
DrawNewDialogBox(DEF_SPRID_INTERFACE_ND_BUTTON, sX + DEF_LBTNPOSX, sY + DEF_BTNPOSY, 19);\par
else DrawNewDialogBox(DEF_SPRID_INTERFACE_ND_BUTTON, sX + DEF_LBTNPOSX, sY + DEF_BTNPOSY, 18);\par
if ( (msX >= sX + DEF_RBTNPOSX) && (msX <= sX + DEF_RBTNPOSX + DEF_BTNSZX)\par
&& (msY >= sY + DEF_BTNPOSY) && (msY <= sY + DEF_BTNPOSY + DEF_BTNSZY))\par
DrawNewDialogBox(DEF_SPRID_INTERFACE_ND_BUTTON, sX + DEF_RBTNPOSX, sY + DEF_BTNPOSY, 3);\par
else DrawNewDialogBox(DEF_SPRID_INTERFACE_ND_BUTTON, sX + DEF_RBTNPOSX, sY + DEF_BTNPOSY, 2);\par
break;\par
